# Copy to terraform.tfvars (ignored by git) and fill in.
project_id = "prepza-prod"
region     = "europe-west1"
domain     = "prepza.ai"
image_tag  = "first"

mail_from  = "prepza. <no-reply@prepza.ai>"
sentry_dsn = ""

# Outage and budget alerts (monitoring.tf).
alert_email     = "you@example.com"
billing_account = "XXXXXX-XXXXXX-XXXXXX"
monthly_budget  = 300

paddle_environment  = "sandbox"
paddle_client_token = ""
paddle_prices = {
  topup_30   = ""
  topup_150  = ""
  topup_250  = ""
  topup_1000 = ""
  # A $0 monthly price: its checkout saves the card for automatic top-ups.
  auto_top_up = ""
}

# Who may open the superadmin pages (templates, the question bank).
superadmin_emails = []
