      "HTTPBearer": []
     }
    ]
   }
  },
  "/internal/events": {
   "post": {
    "tags": [
     "internal"
    ],
    "summary": "Receive Event",
    "description": "Pub/Sub pushes every event here. A failed email or Slack post answers with an error, so\nPub/Sub retries it, and moves it to the dead-letter topic after the subscription's maximum\nattempts; neither Resend nor Slack gets the same message twice. Over Resend's per-second limit\n(a burst of invites) it answers 429: Pub/Sub retries with backoff, and it isn't counted as a\nserver error.",
    "operationId": "receive_event_internal_events_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PushBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "204": {
      "description": "Successful Response"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/webhooks/resend": {
   "post": {
    "tags": [
     "webhooks"
    ],
    "summary": "Resend Webhook",
    "description": "Resend retries until it gets a 2xx, and marking an invite is idempotent, so a failed\ncall to its owner simply comes back later.",
    "operationId": "resend_webhook_webhooks_resend_post",
    "responses": {
     "204": {
      "description": "Successful Response"
     }
    }
   }
  },
