 "components": {
  "schemas": {
   "AutoTopUpIn": {
    "properties": {
     "product": {
      "type": "string",
      "title": "Product"
     },
     "threshold": {
      "type": "integer",
      "title": "Threshold"
     }
    },
    "type": "object",
    "required": [
     "product",
     "threshold"
    ],
    "title": "AutoTopUpIn",
    "description": "Which top-up to buy, and under which available balance (credits)."
   },
   "AutoTopUpOut": {
    "properties": {
     "offered": {
      "type": "boolean",
      "title": "Offered"
     },
     "on": {
      "type": "boolean",
      "title": "On"
     },
     "waiting": {
      "type": "boolean",
      "title": "Waiting"
     },
     "product": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Product"
     },
     "threshold": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Threshold"
     },
     "products": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Products"
     },
     "thresholds": {
      "items": {
       "type": "integer"
      },
      "type": "array",
      "title": "Thresholds"
     },
     "checkout": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/CheckoutOut"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object",
    "required": [
     "offered",
     "on",
     "waiting",
     "product",
     "threshold",
     "products",
     "thresholds"
    ],
    "title": "AutoTopUpOut",
    "description": "A wallet's automatic top-up: whether it's offered at all, running, or waiting for its\ncheckout, what it buys and when, and the choices."
   },
   "BalanceOut": {
