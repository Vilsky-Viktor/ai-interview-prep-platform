 "components": {
  "schemas": {
   "ApiSettingsOut": {
    "properties": {
     "keys": {
      "items": {
       "$ref": "#/components/schemas/KeyOut"
      },
      "type": "array",
      "title": "Keys"
     },
     "expiries": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Expiries"
     },
     "webhooks": {
      "items": {
       "$ref": "#/components/schemas/WebhookOut"
      },
      "type": "array",
      "title": "Webhooks"
     }
    },
    "type": "object",
    "required": [
     "keys",
     "expiries",
     "webhooks"
    ],
    "title": "ApiSettingsOut"
   },
   "Candidate": {
    "properties": {
     "id": {
      "type": "string",
      "format": "uuid",
      "title": "Id"
     },
     "email": {
      "type": "string",
      "title": "Email"
     },
     "name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Name",
      "description": "The candidate's name: as given when they were invited, edited by an owner or admin, or else from their sign-in when they start; null while unknown"
     },
     "status": {
      "type": "string",
      "title": "Status",
      "description": "One of invited, undelivered, in_process, finished, expired or deleted"
     },
     "progress": {
      "type": "integer",
      "title": "Progress",
      "description": "Percentage of the interview answered"
     },
     "grade": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Grade",
      "description": "Final grade in percent; null until the candidate finishes"
     },
     "passed": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Passed",
      "description": "Whether the grade reached the pass mark; null until the candidate finishes. It supports a person's decision: don't reject a candidate automatically on it"
     },
     "signals": {
      "$ref": "#/components/schemas/Signals"
     },
     "flagged": {
      "type": "boolean",
      "title": "Flagged",
      "description": "Whether the integrity signals are too many to trust the result as it is: worth a person's look at the full results, not a reason to reject",
      "default": false
     },
     "extra_time": {
      "type": "integer",
      "title": "Extra Time",
      "description": "Extra time per question the company gave the candidate, in percent",
      "default": 0
     },
     "sections": {
      "anyOf": [
       {
        "items": {
         "$ref": "#/components/schemas/Section"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Sections",
      "description": "Each section's grade, in order; only when one candidate is read, and in web hook events (null in lists)"
     },
     "results_url": {
      "type": "string",
      "title": "Results Url",
      "description": "Link to the candidate's full results and report in prepza"
     },
     "invite_url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Invite Url",
      "description": "The candidate's invite link, to send them yourself if the invite email didn't arrive; null once they've finished or the invite has expired"
     },
     "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "Created At",
      "description": "When the invitation was first sent"
     },
     "started_at": {
      "anyOf": [
       {
        "type": "string",
        "format": "date-time"
       },
       {
        "type": "null"
       }
      ],
      "title": "Started At",
      "description": "When the candidate started; null before"
     },
     "finished_at": {
      "anyOf": [
       {
        "type": "string",
        "format": "date-time"
       },
       {
        "type": "null"
       }
      ],
      "title": "Finished At",
      "description": "When the candidate finished; null before"
     }
    },
    "type": "object",
    "required": [
     "id",
     "email",
     "status",
     "progress",
     "grade",
     "passed",
     "signals",
     "results_url",
     "created_at"
    ],
    "title": "Candidate"
   },
   "CandidateEvent": {
    "properties": {
     "interview": {
      "$ref": "#/components/schemas/Interview"
     },
     "candidate": {
      "$ref": "#/components/schemas/Candidate"
     }
    },
    "type": "object",
    "required": [
     "interview",
     "candidate"
    ],
    "title": "CandidateEvent",
    "description": "The `data` object of a candidate's event (`candidate.finished`, `candidate.started`,\n`candidate.undelivered`, `candidate.expired`): the interview and the candidate as they are\nwhen it's sent."
   },
   "CandidateIn": {
    "properties": {
     "email": {
      "type": "string",
      "format": "email",
      "title": "Email",
      "description": "The candidate's email address"
     },
     "name": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 200
       },
       {
        "type": "null"
       }
      ],
      "title": "Name",
      "description": "The candidate's name, optional (at most 200 characters). It fills a name not known yet; inviting the same address again doesn't change a known one"
     },
     "return_url": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 2048
       },
       {
        "type": "null"
       }
      ],
      "title": "Return Url",
      "description": "Where to take the candidate once they've finished, optional: an https address on the company's verified website domain (or a subdomain of it); see Verified companies. The finished page shows a button to it, with `prepza_invite=<candidate id>` added to its query"
     },
     "theme": {
      "type": "string",
      "enum": [
       "light",
       "dark",
       "default"
      ],
      "title": "Theme",
      "description": "The theme the candidate's pages show, in your company's colors for it: `light` or `dark` always shows that theme, `default` the candidate's own. A `theme` added to the `invite_url` (`?theme=dark`) or given to the SDK wins over it",
      "default": "default"
     },
     "sign_in": {
      "type": "boolean",
      "title": "Sign In",
      "description": "Whether the candidate signs in to prepza with this email, which prepza sends the invitation and its reminder to. Set it to false when your platform already knows who the candidate is and sends them to the response's `invite_url` itself: the link then opens the interview without signing in, and prepza sends no emails. Anyone with that link can take the interview, so give it only to the candidate",
      "default": true
     }
    },
    "type": "object",
    "required": [
     "email"
    ],
    "title": "CandidateIn"
   },
