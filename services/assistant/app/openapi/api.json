 "components": {
  "schemas": {
   "ApiSettingsOut": {
    "properties": {
     "keys": {
      "items": {
       "$ref": "#/components/schemas/KeyOut"
      },
      "type": "array",
      "title": "Keys"
     },
     "expiries": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Expiries"
     },
     "webhooks": {
      "items": {
       "$ref": "#/components/schemas/WebhookOut"
      },
      "type": "array",
      "title": "Webhooks"
     }
    },
    "type": "object",
    "required": [
     "keys",
     "expiries",
     "webhooks"
    ],
    "title": "ApiSettingsOut"
   },
   "Candidate": {
    "properties": {
     "id": {
      "type": "string",
      "format": "uuid",
      "title": "Id"
     },
     "email": {
      "type": "string",
      "title": "Email"
     },
     "name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Name",
      "description": "The candidate's name: as given when they were invited, edited by an owner or admin, or else from their sign-in when they start; null while unknown"
     },
     "status": {
      "type": "string",
      "title": "Status",
      "description": "One of invited, undelivered, in_process, finished, expired or deleted"
     },
     "progress": {
      "type": "integer",
      "title": "Progress",
      "description": "Percentage of the interview answered"
     },
     "grade": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Grade",
      "description": "Final grade in percent; null until the candidate finishes"
     },
     "passed": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Passed",
      "description": "Whether the grade reached the pass mark; null until the candidate finishes. It supports a person's decision: don't reject a candidate automatically on it"
     },
     "signals": {
      "$ref": "#/components/schemas/Signals"
     },
     "results_url": {
      "type": "string",
      "title": "Results Url",
      "description": "Link to the candidate's full results in prepza"
     },
     "invite_url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Invite Url",
      "description": "The candidate's invite link, to send them yourself if the invite email didn't arrive; null once they've finished or the invite has expired"
     },
     "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "Created At",
      "description": "When the invitation was first sent"
     }
    },
    "type": "object",
    "required": [
     "id",
     "email",
     "status",
     "progress",
     "grade",
     "passed",
     "signals",
     "results_url",
     "created_at"
    ],
    "title": "Candidate"
   },
   "CandidateIn": {
    "properties": {
     "email": {
      "type": "string",
      "format": "email",
      "title": "Email",
      "description": "The candidate's email address"
     },
     "name": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 200
       },
       {
        "type": "null"
       }
      ],
      "title": "Name",
      "description": "The candidate's name, optional (at most 200 characters). It fills a name not known yet; inviting the same address again doesn't change a known one"
     }
    },
    "type": "object",
    "required": [
     "email"
    ],
    "title": "CandidateIn"
   },
   "FinishedEvent": {
    "properties": {
     "interview": {
      "$ref": "#/components/schemas/Interview"
     },
     "candidate": {
      "$ref": "#/components/schemas/Candidate"
     }
    },
    "type": "object",
    "required": [
     "interview",
     "candidate"
    ],
    "title": "FinishedEvent",
    "description": "The `data` object of a `candidate.finished` or `candidate.rescored` event."
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "Interview": {
    "properties": {
     "id": {
      "type": "string",
      "format": "uuid",
      "title": "Id"
     },
     "title": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Title",
      "description": "Null while the interview's questions are being generated"
     },
     "status": {
      "type": "string",
      "title": "Status",
      "description": "One of new, in_process or hired"
     },
     "ready": {
      "type": "boolean",
      "title": "Ready",
      "description": "Whether the questions are ready and candidates can be invited"
     },
     "pass_mark": {
      "type": "integer",
      "title": "Pass Mark",
      "description": "The minimum grade, in percent, a candidate needs to pass"
     },
     "candidate_count": {
      "type": "integer",
      "title": "Candidate Count"
     },
     "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "Created At"
     }
    },
    "type": "object",
    "required": [
     "id",
     "title",
     "status",
     "ready",
     "pass_mark",
     "candidate_count",
     "created_at"
    ],
    "title": "Interview"
