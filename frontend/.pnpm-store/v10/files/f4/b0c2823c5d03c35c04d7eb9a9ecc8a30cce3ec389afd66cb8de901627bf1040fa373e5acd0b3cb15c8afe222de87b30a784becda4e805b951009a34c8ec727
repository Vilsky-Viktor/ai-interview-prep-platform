o fall through to\n  // catch-all patterns. See: https://github.com/getsentry/sentry-javascript/issues/19241\n  const normalizedRoute = route.length > 1 && route.endsWith('/') ? route.slice(0, -1) : route;\n\n  // Check route result cache after manifest validation\n  if (routeResultCache.has(normalizedRoute)) {\n    return routeResultCache.get(normalizedRoute);\n  }\n\n  const { staticRoutes, dynamicRoutes } = manifest;\n  if (!Array.isArray(staticRoutes) || !Array.isArray(dynamicRoutes)) {\n    return undefined;\n  }\n\n  const matches = findMatchingRoutes(normalizedRoute, staticRoutes, dynamicRoutes);\n\n  // We can always do the `sort()` call, it will short-circuit when it has one array item\n  const result = matches.sort(compareRouteSpecificity)[0];\n\n  routeResultCache.set(normalizedRoute, result);\n\n  return result;\n};\n"],"names":["GLOBAL_OBJ","DEBUG_BUILD","debug"],"mappings":";;;;;AAIA,MAAM,0BAAA,GAA6BA,eAAA;AAKnC,IAAI,cAAA,GAAuC,IAAA;AAC3C,IAAI,oBAAA,GAA2C,MAAA;AAC/C,MAAM,kBAAA,uBAA8C,GAAA,EAAI;AACxD,MAAM,gBAAA,uBAAwD,GAAA,EAAI;AAKlE,MAAM,cAAA,GAAiB,CAAA;AACvB,MAAM,eAAA,GAAkB,CAAA;AACxB,MAAM,WAAA,GAAc,CAAA;AACpB,MAAM,iBAAA,GAAoB,CAAA;AAC1B,MAAM,0BAAA,GAA6B,CAAA;AAMnC,SAAS,sBAAsB,OAAA,EAAqC;AAClE,EAAA,IAAI,YAAY,MAAA,EAAW;AAEzB,IAAA,OAAO,WAAA;AAAA,EACT;AACA,EAAA,IAAI,CAAC,OAAA,CAAQ,UAAA,CAAW,GAAG,CAAA,EAAG;AAE5B,IAAA,OAAO,cAAA;AAAA,EACT;AAEA,EAAA,MAAM,SAAA,GAAY,OAAA,CAAQ,SAAA,CAAU,CAAC,CAAA;AACrC,EAAA,IAAI,SAAA,CAAU,QAAA,CAAS,IAAI,CAAA,EAAG;AAE5B,IAAA,OAAO,0BAAA;AAAA,EACT;AACA,EAAA,IAAI,SAAA,CAAU,QAAA,CAAS,GAAG,CAAA,EAAG;AAE3B,IAAA,OAAO,iBAAA;AAAA,EACT;AAEA,EAAA,OAAO,eAAA;AACT;AAcA,SAAS,uBAAA,CAAwB,YAAoB,UAAA,EAA4B;AAC/E,EAAA,MAAM,YAAY,UAAA,CAAW,KAAA,CAAM,GAAG,CAAA,CAAE,OAAO,OAAO,CAAA;AACtD,EAAA,MAAM,YAAY,UAAA,CAAW,KAAA,CAAM,GAAG,CAAA,CAAE,OAAO,OAAO,CAAA;AAEtD,EAAA,MAAM,uBAAuB,IAAA,CAAK,GAAA,CAAI,UAAU,MAAA,EAAQ,SAAA,CAAU,MAAM,CAAA,GAAI,CAAA;AAC5E,EAAA,KAAA,IAAS,CAAA,GAAI,CAAA,EAAG,CAAA,GAAI,oBAAA,EAAsB,CAAA,EAAA,EAAK;AAC7C,IAAA,MAAM,UAAA,GAAa,sBAAsB,SAAA,