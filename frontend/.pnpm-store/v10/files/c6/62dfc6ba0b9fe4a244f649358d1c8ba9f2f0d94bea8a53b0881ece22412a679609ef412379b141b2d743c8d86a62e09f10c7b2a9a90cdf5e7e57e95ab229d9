sentry explore cli

# Auto-detect from DSN/config
sentry explore

# Errors with user impact for a specific UTC window
sentry explore my-org/cli -F title -F "count()" -F "count_unique(user)" \\
  --period "2024-01-15T00:00:00Z/2024-01-16T00:00:00Z"

