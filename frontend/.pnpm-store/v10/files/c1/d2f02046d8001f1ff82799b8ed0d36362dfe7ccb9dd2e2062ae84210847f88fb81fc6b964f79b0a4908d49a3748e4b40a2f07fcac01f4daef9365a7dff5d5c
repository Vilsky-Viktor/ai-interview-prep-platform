  /** Only show items of this type (repeatable: error, transaction, log, ai) */
  filter?: string;
  /** Verify SDK sends events, then exit */
  verify?: boolean;
  /** Kill the child after N seconds (0 = no timeout; defaults to 30 s in --verify mode) */
  timeout?: number;
  /** Output format: human (default) or json (NDJSON on stdout) */
  format?: string;
  /** Include selected event attributes in output */
  attributes?: boolean;
  /** Open Sentry Local UI in the browser */
