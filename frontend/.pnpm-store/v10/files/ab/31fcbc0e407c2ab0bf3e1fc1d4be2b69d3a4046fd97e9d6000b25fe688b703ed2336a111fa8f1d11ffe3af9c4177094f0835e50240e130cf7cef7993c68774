 string | undefined, client?: Client): string | undefined {\n  return query ? filterQueryParams(query, urlQueryParamsBehavior(client)) : undefined;\n}\n"],"names":["getClient","filterUrlQuery","filterQueryParams"],"mappings":";;;;;;AAMA,SAAS,uBAAuB,MAAA,EAA6C;AAE3E,EAAA,OAAA,CAAQ,MAAA,IAAUA,uBAAA,EAAU,GAAI,wBAAA,GAA2B,cAAA,IAAkB,IAAA;AAC/E;AAcO,SAAS,kBAAA,CAAmB,KAAyB,MAAA,EAAqC;AAC/F,EAAA,OAAO,QAAQ,MAAA,GAAY,MAAA,GAAYC,8BAAe,GAAA,EAAK,sBAAA,CAAuB,MAAM,CAAC,CAAA;AAC3F;AAQO,SAAS,uBAAA,CAAwB,OAA2B,MAAA,EAAqC;AACtG,EAAA,OAAO,QAAQC,mCAAA,CAAkB,KAAA,EAAO,sBAAA,CAAuB,MAAM,CAAC,CAAA,GAAI,MAAA;AAC5E;;;;;"}