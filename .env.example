# Copy to .env before running docker compose.

# Firebase project. A "demo-" project id lets the Auth emulator run without real credentials.
FIREBASE_PROJECT_ID=demo-prepza
# Local development only: while set, services accept unsigned tokens from the Auth emulator.
# Only docker-compose.override.yml passes it on, and services refuse to start with it unless
# FIREBASE_PROJECT_ID starts with "demo-". Leave empty for a real Firebase project.
FIREBASE_AUTH_EMULATOR_HOST=firebase-auth:9199

# Frontend (baked into the build).
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-prepza.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-prepza
# Local development only: the browser talks to the Auth emulator here. Leave empty in production.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9199

# Databases.
POSTGRES_PASSWORD=prepza

# Signs service-to-service tokens. Use a long random value (at least 32 characters).
SERVICE_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Question generation.
OPENAI_API_KEY=
TAVILY_API_KEY=
# OpenAI model for generation, grading and chat. A mini model (e.g. gpt-4o-mini) costs about
# 15x less; check the quality on your own topics before switching.
LLM_MODEL=gpt-4o
# Questions generated per topic. Every question also gets a reference answer and 3 wrong
# options, so this drives the cost of each preparation most.
QUESTIONS_PER_TOPIC=20

# Emails. Locally they go to mailpit (http://localhost:8125).
SITE_URL=http://localhost:8090
SMTP_HOST=mailpit
SMTP_PORT=1025

# Optional LangSmith tracing for generation and grading/chat.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=prepza

# Per-user rate limits. Set a limit to 0 to disable it.
GENERATION_LIMIT=20
GENERATION_WINDOW_SECONDS=86400
LLM_LIMIT=400
LLM_WINDOW_SECONDS=3600
