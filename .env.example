# Copy to .env before running docker compose.

# Firebase project. A "demo-" project id lets the Auth emulator run without real credentials.
FIREBASE_PROJECT_ID=demo-prepza
# Local development only: while set, services accept unsigned tokens from the Auth emulator.
# docker-compose.yml passes it to the services, which refuse to start with it unless
# FIREBASE_PROJECT_ID starts with "demo-". Leave empty for a real Firebase project.
FIREBASE_AUTH_EMULATOR_HOST=firebase-auth:9199

# Frontend (baked into the build).
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-prepza.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-prepza
# Local development only: the browser talks to the Auth emulator here. Leave empty in production.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9199

# Databases.
POSTGRES_PASSWORD=prepza

# Signs service-to-service tokens. Use a long random value (at least 32 characters).
SERVICE_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Question generation.
OPENAI_API_KEY=
# Each AI task's OpenAI model, and how hard it thinks (none, minimal, low, medium, high; a
# reasoning model only).
# Generation: topics, questions and re-generated questions.
INTERVIEW_MODEL=gpt-6.1-sol
INTERVIEW_REASONING_EFFORT=low
# The verifier, which checks answer keys: rare, and it must be right.
VERIFY_MODEL=gpt-6.1-sol
VERIFY_REASONING_EFFORT=medium
# The FAQ's help chat, free for everyone: fast and cheap. At none it also gets a temperature.
HELP_MODEL=gpt-6-luna
HELP_REASONING_EFFORT=none
# Questions generated per topic: for a company's test, and for a template (more: a third is
# revealed for free practice, the rest is copied into companies' tests). Each question also gets
# a correct option and 3 wrong ones.
INTERVIEW_QUESTIONS_PER_TOPIC=70
TEMPLATE_QUESTIONS_PER_TOPIC=90
# Main topics an interview or a template has, and subtopics each topic has: every subtopic is at least
# one model call.
MAX_TOPICS=10
MAX_SUBTOPICS=10
# LLM requests a second across all generation processes (0 = no limit); stay under your OpenAI limit.
LLM_REQUESTS_PER_SECOND=8

# Emails. With RESEND_API_KEY (below) set they go out through Resend, from MAIL_FROM on a domain
# verified in Resend. Without it they go to mailpit (http://localhost:8125).
SITE_URL=http://localhost:8090
MAIL_FROM=prepza. <no-reply@prepza.local>
# Sender of the emails users may turn off (the activity digest, reminders), on a domain of its own
# (verified in Resend too), so spam complaints about them can't hurt the service emails.
MAIL_FROM_UPDATES=prepza. <updates@mail.prepza.local>
SMTP_HOST=mailpit
SMTP_PORT=1025
# Where contact page messages go (notifications), and replies to emails that have no one else to
# answer.
CONTACT_EMAIL=hello@prepza.ai

# ATS integrations (the ats service): the Fernet key that encrypts companies' ATS keys. Make one with
# python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Empty turns integrations off.
ATS_ENCRYPTION_KEY=

# The public API (the api service): the Fernet key that encrypts web hooks' signing secrets, made
# the same way. Empty: API keys work, but web hooks can't be added.
API_ENCRYPTION_KEY=

# Payments (Paddle). "sandbox" for testing. The client token is public by design; the webhook
# secret and each product's price id come from Paddle's dashboard. A product without a price id
# isn't sold.
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_TOPUP_30=
PADDLE_PRICE_TOPUP_150=
PADDLE_PRICE_TOPUP_250=
PADDLE_PRICE_TOPUP_1000=
# Automatic top-up, offered only with both: a $0 monthly price whose checkout saves the card,
# and a server-side API key (Developer tools → Authentication) that charges it.
PADDLE_PRICE_AUTO_TOP_UP=
PADDLE_API_KEY=

# Error tracking (Sentry). Empty DSNs send nothing. The backend and the frontend are separate
# Sentry projects; the frontend's DSN is public by design (it's in the browser).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional LangSmith tracing for generation and chat.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=prepza

# Per-user rate limits. Set a limit to 0 to disable it.
GENERATION_LIMIT=20
GENERATION_WINDOW_SECONDS=86400
# Single questions a user may re-generate in that window.
REGENERATION_LIMIT=100
# New generations a day for everyone together, a ceiling on LLM spending; 0 turns it off.
DAILY_GENERATION_LIMIT=200
# The FAQ's help chat: messages per signed-in account an hour, and in all a day. Contact page
# messages a day in all.
HELP_USER_LIMIT=30
HELP_DAILY_LIMIT=5000
CONTACT_DAILY_LIMIT=200
# Candidate invite emails per user an hour and a day, and invites one address may get a day for
# the same test.
EMAIL_HOURLY_LIMIT=100
EMAIL_DAILY_LIMIT=200
EMAIL_RECIPIENT_DAILY_LIMIT=3
# Report emails one company may send a day, all its members together.
REPORT_EMAILS_PER_COMPANY_DAY=20

# Email service
RESEND_API_KEY=
# Signing secret (whsec_...) of the Resend webhook for bounces and complaints; see README.
RESEND_WEBHOOK_SECRET=
# Signs the unsubscribe links in emails, so nobody can make one for someone else's address. Any
# long random string (`openssl rand -hex 32`); changing it breaks the links in emails already sent.
EMAIL_LINK_SECRET=local-email-link-secret

# Slack: prepza's Slack app from api.slack.com (scope incoming-webhook, redirect URL
# <SITE_URL>/api/notifications/slack/callback, public distribution on), and a Fernet key that seals
# each company's channel web hook (python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"). Empty: "Add to Slack" says Slack isn't set up yet.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_ENCRYPTION_KEY=

# Superadmins, prepza's own team (templates, the question bank): verified Google emails, comma-separated.
SUPERADMIN_EMAILS=
# Salts user ids in funnel events (analytics); in Google Cloud it's a secret.
ANALYTICS_SALT=local-analytics-salt

# Signs the titles link-preview pictures draw (/preview), so nobody else can put text under the
# logo. Any long random string; `openssl rand -hex 32` makes one.
PREVIEW_SECRET=

# Search engines: the tokens from Google Search Console's and Bing Webmaster Tools' meta-tag
# checks (frontend). Empty adds no tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
