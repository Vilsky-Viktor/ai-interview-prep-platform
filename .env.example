# Copy to .env before running docker compose.

# Firebase project. A "demo-" project id lets the Auth emulator run without real credentials.
FIREBASE_PROJECT_ID=demo-prepza
# Local development only: while set, services accept unsigned tokens from the Auth emulator.
# Only docker-compose.override.yml passes it on, and services refuse to start with it unless
# FIREBASE_PROJECT_ID starts with "demo-". Leave empty for a real Firebase project.
FIREBASE_AUTH_EMULATOR_HOST=firebase-auth:9199

# Frontend (baked into the build).
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-prepza.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-prepza
# Local development only: the browser talks to the Auth emulator here. Leave empty in production.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9199

# Databases.
POSTGRES_PASSWORD=prepza

# Signs service-to-service tokens. Use a long random value (at least 32 characters).
SERVICE_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Question generation.
OPENAI_API_KEY=
# OpenAI model for generation and the follow-up chat.
LLM_MODEL=gpt-6-luna
# How hard the model thinks (none, minimal, low, medium, high), for a reasoning model only:
# generation, and the verifier that checks a flagged question's answer key.
LLM_REASONING_EFFORT=low
VERIFY_REASONING_EFFORT=medium
# Questions generated per topic. Each question also gets a correct option and 3 wrong ones.
QUESTIONS_PER_TOPIC=100
# LLM requests a second across all generation processes (0 = no limit); stay under your OpenAI limit.
LLM_REQUESTS_PER_SECOND=8

# Emails. With RESEND_API_KEY (below) set they go out through Resend, from MAIL_FROM on a domain
# verified in Resend. Without it they go to mailpit (http://localhost:8125).
SITE_URL=http://localhost:8090
MAIL_FROM=prepza. <no-reply@prepza.local>
SMTP_HOST=mailpit
SMTP_PORT=1025

# Payments (Paddle). "sandbox" for testing. The client token is public by design; the webhook
# secret and each product's price id come from Paddle's dashboard. A product without a price id
# isn't sold.
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_TOPUP_10=
PADDLE_PRICE_TOPUP_25=
PADDLE_PRICE_TOPUP_50=
PADDLE_PRICE_TOPUP_100=
PADDLE_PRICE_TOPUP_250=
PADDLE_PRICE_TOPUP_500=
# A $1 price; custom top-ups of $10 to $500 buy it in that quantity.
PADDLE_PRICE_TOPUP_CUSTOM=
# Automatic top-up, offered only with both: a $0 monthly price whose checkout saves the card,
# and a server-side API key (Developer tools → Authentication) that charges it.
PADDLE_PRICE_AUTO_TOP_UP=
PADDLE_API_KEY=

# Error tracking (Sentry). Empty DSNs send nothing. The backend and the frontend are separate
# Sentry projects; the frontend's DSN is public by design (it's in the browser).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional LangSmith tracing for generation and chat.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=prepza

# Per-user rate limits. Set a limit to 0 to disable it.
GENERATION_LIMIT=20
GENERATION_WINDOW_SECONDS=86400
# New generations a day for everyone together, a ceiling on LLM spending; 0 turns it off.
DAILY_GENERATION_LIMIT=0
LLM_LIMIT=400
LLM_WINDOW_SECONDS=3600
# Invite emails (shares and candidate invites together) per user an hour and a day, and invites
# one address may get a day for the same preparation or interview.
EMAIL_HOURLY_LIMIT=30
EMAIL_DAILY_LIMIT=200
EMAIL_RECIPIENT_DAILY_LIMIT=3

# Email service
RESEND_API_KEY=
MAIL_FROM=yourname <no-reply@yourdomain.com>
# Signing secret (whsec_...) of the Resend webhook for bounces and complaints; see README.
RESEND_WEBHOOK_SECRET=
